{
    "name": "Postfy",
    "short_name": "Postfy",
    "description": "Connect, share and engage with your community.",
    "start_url": "{{ url_for('home') }}",
    "scope": "{{ url_for('home') }}",
    "display": "standalone",
    "background_color": "#0b0d12",
    "theme_color": "#0b0d12",
    "icons": [
        { "src": "{{ url_for('static', filename='images/logo-192.png') }}", "sizes": "192x192", "type": "image/png" },
        { "src": "{{ url_for('static', filename='images/logo-512.png') }}", "sizes": "512x512", "type": "image/png" }
    ]
}
